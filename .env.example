# Eidos — provider configuration.
# Every provider has an offline fallback, so the app runs with none of these set.

# Cycle AI (Anthropic Claude). Leave unset to use the on-device heuristic engine.
VITE_CYCLE_API_BASE=
VITE_CYCLE_MODEL=claude-sonnet-5

# Weather (Open-Meteo needs no key; set a base URL to proxy it)
VITE_WEATHER_API_BASE=https://api.open-meteo.com/v1

# News headlines feed (expects { items: [{title, source, url, category}] })
VITE_NEWS_API_BASE=

# Korean school meal / timetable open API (NEIS). Unset -> bundled sample school data.
VITE_NEIS_API_BASE=https://open.neis.go.kr/hub
VITE_NEIS_KEY=
